# Banco de dados Postgres (Neon, Supabase, Vercel Postgres, etc.)
# Use a URL com pooler quando disponível (recomendado para serverless).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require

# Primeiro usuário administrador. Na primeira tentativa de login com estes
# dados, a conta é criada automaticamente no banco.
AUTH_ADMIN_EMAIL=admin@oficina.com
AUTH_ADMIN_PASSWORD=troque-esta-senha
AUTH_ADMIN_NAME=Administrador

# Vercel Blob (store privado). Criado em Storage > Blob no painel da Vercel.
# O upload de documentos exige o token de leitura/escrita.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Opcional: restrinja o CORS a origens específicas separadas por vírgula.
# CORS_ORIGIN=https://seu-projeto.vercel.app

# Opcional: nível de log (trace, debug, info, warn, error, fatal).
# LOG_LEVEL=info
